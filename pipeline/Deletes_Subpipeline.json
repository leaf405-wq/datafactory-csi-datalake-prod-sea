						"parameters": {
							"Table_Name": ".",
							"Schema": "."
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Error Log Lookup Activity",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Watermark Lookup",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
