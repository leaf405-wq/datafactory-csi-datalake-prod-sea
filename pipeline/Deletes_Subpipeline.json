								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "INSERT INTO dbo.C4C__JobLog (JobName,JobDate,JobUser,JobStatus,CallingModule,JobLevel) OUTPUT INSERTED.JobStatus Values (\n    '@{pipeline().parameters.JobName}',\n    '@{FormatDateTime(pipeline().TriggerTime,'yyyy-MM-dd HH:MM:ss.FFF')}',\n    'MSADF',\n    '@{\n        concat(\n            'Cannot find deletes mapping for table ', pipeline().parameters.TableName\n        )\n    }',\n    '@{pipeline().parameters.CallingModule}',\n    '4'\n)",
