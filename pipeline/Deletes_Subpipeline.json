				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "Update dbo.C4C__JobLog\nSET JobStatus\n= '@{REPLACE(activity('Watermark Lookup').Error.Message,'''','')}'\nOUTPUT 1 WHERE \nCallingModule='@{concat(pipeline().RunId,'-',activity('Watermark Lookup').output.value[0].Collection_Name)}';",
