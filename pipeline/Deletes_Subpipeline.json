										"value": {
											"value": "@pipeline().parameters.JobName",
											"type": "Expression"
										},
										"type": "String"
									},
									"MaxDeleteDate": {
										"value": "ReceivedDate",
										"type": "String"
									},
									"NodeName": {
										"value": {
											"value": "@activity('Watermark Lookup').output.value[0].Node",
											"type": "Expression"
										},
										"type": "String"
									},
									"ObjectName": {
										"value": {
											"value": "@activity('Watermark Lookup').output.value[0].Object",
											"type": "Expression"
										},
										"type": "String"
									},
									"Table_Name": {
										"value": {
											"value": "@activity('Watermark Lookup').output.value[0].Table_Name",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "SqlServerLinkedService",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Error Log Copy Activity",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Copy data from Azure table to DataLake",
									"dependencyConditions": [
										"Failed"
									]
								}
