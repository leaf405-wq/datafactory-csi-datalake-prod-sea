				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "select * from Stage.LookupTable_Deletes where Table_Name = '@{pipeline().parameters.TableName}'",
