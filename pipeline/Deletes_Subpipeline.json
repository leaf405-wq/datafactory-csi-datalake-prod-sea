				"dependsOn": [
					{
						"activity": "Watermark Lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Watermark Lookup').output.count,0)",
