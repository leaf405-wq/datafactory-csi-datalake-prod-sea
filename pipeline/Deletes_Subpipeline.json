										"value": "Update dbo.C4C__JobLog\nSET JobStatus\n= '@{REPLACE(activity('Copy data from Azure table to DataLake').Error.Message,'''','')}'\nOUTPUT 1 WHERE \nCallingModule='@{concat(pipeline().RunId,'-',activity('Watermark Lookup').output.value[0].Collection_Name)}';",
