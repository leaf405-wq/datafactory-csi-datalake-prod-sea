										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SqlServerParameterizedDataset",
									"type": "DatasetReference",
									"parameters": {
										"Table_Name": ".",
										"Schema": "."
									}
								},
								"firstRowOnly": false
							}
						},
						{
							"name": "Copy data from Azure table to DataLake",
							"type": "Copy",
							"dependsOn": [],
