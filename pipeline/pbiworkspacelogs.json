{
	"name": "pbiworkspacelogs",
	"properties": {
		"activities": [
			{
				"name": "Set variable1-Start Date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Start_Date",
					"value": {
						"value": "@formatDateTime(startOfDay(getPastTime(1,'Day')),'yyyy-MM-ddTHH:mm:ss.fffZ')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable2-End Date",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set variable1-Start Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "end_date",
					"value": {
						"value": "@formatDateTime(addminutes(addhours(startOfDay(getPastTime(1,'Day')),23),59) ,'yyyy-MM-ddTHH:mm:ss.fffZ')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy data - API to sQL",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set variable2-End Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"AbsoluteUrl": "$.$['continuationUri']"
						}
					},
					"sink": {
						"type": "SqlServerSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"tableOption": "autoCreate"
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "PowerBIDataset",
						"type": "DatasetReference",
						"parameters": {
							"start_date": {
								"value": "@variables('Start_Date')",
								"type": "Expression"
							},
							"end_date": {
								"value": "@variables('end_date')",
								"type": "Expression"
							},
							"tick": "'"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "SqlServerParameterizedDataset",
						"type": "DatasetReference",
						"parameters": {
							"Table_Name": "pbiactivityevents",
							"Schema": "dbo"
						}
					}
				]
			}
		],
		"variables": {
			"Start_Date": {
				"type": "String"
			},
			"end_date": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-08-25T02:15:33Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}